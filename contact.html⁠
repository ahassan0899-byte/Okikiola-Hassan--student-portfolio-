<body>

  <header>
    <nav class="navbar">
      <div class="logo">Okikiola<span>.dev</span></div>
      <ul class="nav-links">
        <li><a href="index.html">Home</a></li>
        <li><a href="about.html">About Me</a></li>
        <li><a href="projects.html">Projects</a></li>
        <li><a href="planner.html">Academic Planner</a></li>
        <li><a href="contact.html" class="active">Contact</a></li>
      </ul>
    </nav>
  </header>

  <main class="container">
    <h1>Contact Me</h1>
    <p class="subtitle">Get in touch via email, phone, or by sending a direct message below.</p>

    <!-- Direct Contact Details -->
    <div class="about-card" style="margin-bottom: 2rem;">
      <h2>📬 Direct Contact Information</h2>
      <p style="margin-top: 0.5rem;"><strong>Email:</strong> <a href="mailto:A.hassan0899@miva.edu.ng" style="color: #2563eb;">A.hassan0899@miva.edu.ng</a></p>
      <p style="margin-top: 0.5rem;"><strong>Phone:</strong> <a href="tel:+2349022243037" style="color: #2563eb;">+234 902 224 3037</a></p>
      <p style="margin-top: 0.5rem;"><strong>Institution:</strong> Miva Open University</p>
    </div>

    <!-- Contact Form -->
    <div class="contact-wrapper">
      <h2>Send a Message</h2>
      <div id="error-message" class="alert-box error" style="display: none; margin-top: 1rem;"></div>
      <div id="success-message" class="alert-box success" style="display: none; margin-top: 1rem;"></div>

      <form id="contact-form" novalidate style="margin-top: 1rem;">
        <div class="form-group">
          <label for="fullname">Full Name *</label>
          <input type="text" id="fullname" name="fullname" placeholder="Okikiola Arowoshola">
        </div>

        <div class="form-group">
          <label for="email">Email Address *</label>
          <input type="email" id="email" name="email" placeholder="A.hassan0899@miva.edu.ng">
        </div>

        <div class="form-group">
          <label for="phone">Phone Number *</label>
          <input type="tel" id="phone" name="phone" placeholder="+2349022243037">
        </div>

        <div class="form-group">
          <label for="message">Message *</label>
          <textarea id="message" name="message" rows="5" placeholder="Write your message..."></textarea>
        </div>

        <button type="submit" class="btn primary-btn">Send Message</button>
      </form>
    </div>
  </main>

  <footer>
    <p>&copy; 2026 Okikiola Hassan Arowoshola | COS 106 Term Project</p>
  </footer>

  <script src="js/script.js"></script>
